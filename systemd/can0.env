# B-CAN bitrate. Both FCA reference implementations use 50 kbit/s and the
# Giulietta is expected to match, but this is verified in Phase 1 by checking
# that the interface reports zero bus errors with a live car attached.
BITRATE=50000

# Controller mode. "listen-only on" is the safe default and must stay until the
# giulietta940 profile has been populated from real captures.
#   listen-only on    receive only; the controller does not even ACK
#   listen-only off   normal mode; required before any frame can be transmitted.
#                     Not empty: ip keeps the controller's flags as they were, so
#                     an empty value leaves listen-only on after a restart.
# tx.sh on / off switches this and the app's mode together.
CTRLMODE=listen-only on
